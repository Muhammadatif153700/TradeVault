@page "/Account/ForgotPasswordConfirmation"

@using Microsoft.AspNetCore.Identity
@using TradeVault.Components.Account

@inject NavigationManager NavigationManager

<PageTitle>Password Reset Sent — TradeVault</PageTitle>

<div class="tv-auth-page">
    <div class="tv-auth-card" style="max-width: 520px;">
        <div class="tv-auth-logo" style="text-align: center; margin-bottom: 24px;">
            <div class="tv-logo-icon" style="margin: 0 auto 12px; font-size: 24px; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: var(--gradient-primary); border-radius: 12px; box-shadow: 0 0 20px rgba(212,175,55,0.2); color: #000;">🔐</div>
            <h2 class="tv-auth-title" style="font-size: 24px; font-weight: 700; font-family: 'Space Grotesk', sans-serif;">Reset Link Sent</h2>
            <p class="tv-auth-sub" style="font-size: 13.5px; color: var(--text-muted); margin-top: 6px;">Please check your email to reset your password.</p>
        </div>

        <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: var(--radius-md); padding: 18px; margin-bottom: 24px; text-align: center;">
            <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
                If a matching account exists, a link to reset your password has been sent to your email address.
            </p>
        </div>

        @if (simulatedMessage is not null)
        {
            <!-- Developer Sandbox Email Capture Simulator -->
            <div style="border: 1px solid rgba(212, 175, 55, 0.25); background: rgba(212, 175, 55, 0.02); border-radius: var(--radius-md); padding: 20px; position: relative; margin-top: 24px; animation: slideUp 0.3s ease;">
                <div style="position: absolute; top: -10px; left: 16px; background: #0c0c0c; border: 1px solid rgba(212, 175, 55, 0.3); padding: 2px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; color: var(--accent-primary); text-transform: uppercase; letter-spacing: 0.5px;">
                    🛠️ Developer Sandbox Mailbox
                </div>
                <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 6px; margin-bottom: 12px; line-height: 1.4;">
                    Since this is a development instance, the outgoing password reset email was captured locally:
                </div>
                
                <div style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05); border-radius: var(--radius-sm); padding: 14px; text-align: left; font-family: system-ui, sans-serif; box-shadow: inset 0 2px 10px rgba(0,0,0,0.5);">
                    <div style="font-size: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px; margin-bottom: 10px; color: var(--text-muted); line-height: 1.6;">
                        <strong>From:</strong> accounts@tradevault.com<br />
                        <strong>To:</strong> @simulatedMessage.To<br />
                        <strong>Subject:</strong> @simulatedMessage.Subject
                    </div>
                    <div>
                        @((MarkupString)simulatedMessage.Body)
                    </div>
                </div>
            </div>
        }

        <div style="text-align: center; margin-top: 24px; font-size: 13.5px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 20px;">
            <a href="Account/Login" style="color: var(--accent-primary); font-weight: 600; text-decoration: none;">← Back to Login</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    private SimulatedMailbox.MailMessage? simulatedMessage;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            simulatedMessage = SimulatedMailbox.GetLatestMessageFor(Email);
        }
    }
}
