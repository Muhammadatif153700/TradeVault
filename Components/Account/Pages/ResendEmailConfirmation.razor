@page "/Account/ResendEmailConfirmation"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using TradeVault.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Resend Email Verification — TradeVault</PageTitle>

<div class="tv-auth-page">
    <div class="tv-auth-card" style="max-width: 460px;">
        <div class="tv-auth-logo" style="text-align: center; margin-bottom: 24px;">
            <div class="tv-logo-icon" style="margin: 0 auto 12px; font-size: 20px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: rgba(212,175,55,0.08); border: 1px solid var(--glass-border); border-radius: 10px; color: var(--accent-primary);">✉️</div>
            <h2 class="tv-auth-title" style="font-size: 22px; font-weight: 700; font-family: 'Space Grotesk', sans-serif;">Resend Verification</h2>
            <p class="tv-auth-sub" style="font-size: 13px; color: var(--text-muted); margin-top: 6px;">Enter your email to request another confirmation link</p>
        </div>
        
        <StatusMessage Message="@message" />

        <EditForm Model="Input" FormName="resend-email-confirmation" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />
            
            <div class="tv-form-group">
                <label for="Input.Email" class="tv-label">Email Address</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="tv-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            
            <button type="submit" class="tv-btn tv-btn-primary w-full" style="justify-content:center; padding:12px; margin-top:16px;">Send Link</button>
            
            <div style="text-align:center; margin-top:20px; font-size:13.5px;">
                <a href="Account/Login" style="color:var(--accent-primary); text-decoration: none;">← Back to Login</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email!);
        if (user is null)
        {
            // Do not reveal if the user exists or not
            message = "Verification link has been sent. If the email is registered, you will receive it shortly.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });
        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        // Redirect to RegisterConfirmation so they can see the simulated sandbox mail capture link!
        RedirectManager.RedirectTo($"Account/RegisterConfirmation?Email={Uri.EscapeDataString(Input.Email)}");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
