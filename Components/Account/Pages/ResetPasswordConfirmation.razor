@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password Reset Success — TradeVault</PageTitle>

<div class="tv-auth-page">
    <div class="tv-auth-card" style="max-width: 460px; text-align: center;">
        <div class="tv-auth-logo" style="margin-bottom: 24px;">
            <div class="tv-logo-icon" style="margin: 0 auto 16px; font-size: 28px; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #10b981; border-radius: 50%; box-shadow: 0 0 20px rgba(16,185,129,0.15); animation: pulse 2s infinite;">✓</div>
            <h2 class="tv-auth-title" style="font-size: 24px; font-weight: 700; font-family: 'Space Grotesk', sans-serif; color: var(--text-primary);">Password Changed</h2>
            <p class="tv-auth-sub" style="font-size: 13.5px; color: var(--text-muted); margin-top: 6px;">Your password has been successfully reset.</p>
        </div>

        <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); border-radius: var(--radius-md); padding: 20px; margin-bottom: 24px;">
            <p style="font-size: 14.5px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
                You can now log in to your account with your new credentials.
            </p>
        </div>

        <a href="Account/Login" class="tv-btn tv-btn-primary w-full" style="justify-content: center; padding: 12px; font-size: 14.5px; text-decoration: none;">
            Sign In Now
        </a>
    </div>
</div>
